# ============================================================
# IBVAP Backend — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
# All paths are portable — use environment variables, not hardcoded paths.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://ibvap:ibvap123@localhost:5432/ibvap_db
# SQLite fallback (auto-used if DATABASE_URL is not set):
# DATABASE_URL=sqlite:///./data/ibvap_ai.db

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- MinIO Object Storage ----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme123
MINIO_SECURE=False

# ---- JWT Security ----
JWT_SECRET=change-this-to-a-random-secure-string-in-production
JWT_ALGORITHM=HS256

# ---- API ----
PROJECT_NAME=AssistanCCTV AI Backend
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Portable Paths (use relative or env-relative paths) ----
# These are resolved relative to the backend directory by default.
# Override with absolute paths only if running in a non-standard layout.
# MODEL_DIR=./models
# DATA_DIR=./data
# EVIDENCE_DIR=./data/evidence
# UPLOAD_DIR=./data/uploads

# ---- AI Models ----
# YOLO model filename inside MODEL_DIR (default: yolov8n.pt)
# YOLO_MODEL=yolov8n.pt

# ---- Camera Discovery ----
# Default camera index for LOCAL_WEBCAM mode (0 = first available, auto-discovered at runtime)
# CAMERA_DEFAULT_INDEX=0

# ---- Frontend (for Vite) ----
# These go in the frontend .env file (src/.env or root/.env), not here.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
